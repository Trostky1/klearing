# Shopify Dev Dashboard credentials. Copy this file to:
# Windows: %LOCALAPPDATA%\\Klearing\\.env
# macOS: ~/Library/Application Support/Klearing/.env
# Development: the repository root .env
# In Shopify Dev Dashboard, add http://localhost:47832/shopify/callback
# as an allowed redirection URL for this app.
KLEARING_SHOPIFY_CLIENT_ID=<your-shopify-client-id>
KLEARING_SHOPIFY_CLIENT_SECRET=<your-shopify-client-secret>

# Plaid Phase 1: non-OAuth institutions only. Use Sandbox keys for testing.
PLAID_CLIENT_ID=<your-plaid-client-id>
PLAID_SECRET=<your-plaid-sandbox-secret>
PLAID_ENV=sandbox

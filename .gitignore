# Secrets and local data — never committed
.env
.env.*
!.env.example
*.db
*.log
*.json.key
service-account*.json
*.klearingbackup

# Python
__pycache__/
*.pyc
venv/
.venv/

# Build output
build/dist/
build/work/
build/work-*/
*.spec.bak
dist/
dist-*/

